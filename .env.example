# ─────────────────────────────────────────────────────────────────────────────
# NIFTY + SENSEX AI Agent — Environment Variables
# Copy to .env and fill in your real values. Never commit .env!
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic Claude API (optional — leave blank to skip AI signal explanations)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# ── Pushover (iPhone/Android push notifications) ──────────────────────────────
# Sign up at https://pushover.net (free for 30 days, $5 one-time after)
# 1. Create account → copy your User Key below
# 2. Create an Application → copy its API Token below
# Set PUSHOVER_ENABLED=false to deliver via Telegram only (keys can then stay blank).
PUSHOVER_ENABLED=true
PUSHOVER_USER_KEY=
PUSHOVER_API_TOKEN=

# ── Telegram broadcast bot (optional — multi-user delivery) ───────────────────
# Create a bot with @BotFather on Telegram, copy the token it gives you here.
# When set, the agent runs a bot others can /start to subscribe; every signal is
# fanned out to all subscribers (they need no broker account — signals only).
# Leave blank to stay single-user via Pushover.
TELEGRAM_BOT_TOKEN=

# ── Upstox API (optional — enables live weekly + monthly option chain data) ────
# Developer console: https://account.upstox.com/developer/apps
#
# EASIEST: paste an Analytics Access Token into UPSTOX_ACCESS_TOKEN below
# (your app → Generate Token). Read-only, market-data only, valid ~1 year — no
# daily refresh, and the KEY/SECRET/REDIRECT_URI below can stay blank.
#
# ALTERNATIVE: fill in KEY/SECRET/REDIRECT_URI and run scripts/upstox_login.py
# each morning to write a daily-expiring token. Redirect URI must be a real
# https:// URL (localhost/http are rejected by Upstox).
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=https://www.google.com/upstox-callback
# Analytics Access Token (~1yr) OR a daily token from scripts/upstox_login.py
UPSTOX_ACCESS_TOKEN=

# Database (SQLite by default; swap to postgresql://user:pass@host/db for prod)
DATABASE_URL=sqlite:///nifty_ai_agent.db

# Market data
NIFTY_SYMBOL=^NSEI
SENSEX_SYMBOL=^BSESN
BANKNIFTY_SYMBOL=^NSEBANK
DATA_FETCH_INTERVAL_MINUTES=5
DATA_INTERVAL=5m
HISTORICAL_DAYS=10

# Suggest the contract expiring TODAY (NIFTY weekly expiry is Tuesday).
# Off by default: on expiry day the extrinsic value has collapsed and gamma/theta
# dominate, so a directional signal with an SL and a 1:2 RR target rarely survives.
# Turn on only if you deliberately trade expiry-day scalps.
ALLOW_EXPIRY_DAY_OPTIONS=false

# Capital — sizes the margin/lots section of the signal notification.
# The trade plan is prices-only (buy/sell/exit) and ignores this.
TRADING_CAPITAL=50000

# Only notify when a signal's confidence is at least this % (gates the intraday
# trade call incl. EOD prediction, trade plan, and stock scan; lower-conviction
# signals are still saved, just not pushed). 0 = notify on everything (no filter).
MIN_SIGNAL_CONFIDENCE=0

# Risk
MAX_RISK_PER_TRADE_PCT=1.0
DAILY_LOSS_LIMIT_PCT=3.0
MIN_RISK_REWARD_RATIO=2.0
# Stop-loss distance as a multiple of ATR — shared by the risk and margin engines
ATR_SL_MULTIPLIER=1.5

# ── Next-session outlook (GIFT Nifty) ─────────────────────────────────────────
# Calendar days of NIFTY daily bars used to compute gap base rates. 400d ≈ 275
# trading sessions — enough to populate the rarer large-gap buckets, which are the
# ones that actually carry an edge (large gap-ups have historically FADED).
GAP_HISTORY_DAYS=400

# ── Margin (the margin/lots section of the signal notification) ───────────────
# Share of capital that may be committed as margin. Below 100 keeps a buffer so a
# single trade cannot block every rupee you have.
MAX_MARGIN_UTILISATION_PCT=100.0

# ── Stock option scan (NIFTY 50 constituents) ─────────────────────────────────
# A scheduled scan of single-stock MONTHLY options across the NIFTY 50, sent as
# one Pushover digest of the best CE/PE ideas. Strikes/lots resolve from Upstox's
# public instrument master (no token needed); a token adds live premiums, and
# without one the premium is a Black-Scholes estimate.
STOCK_SCAN_ENABLED=true
# How often (minutes) to run the CE/PE scan during market hours (09:15–15:30).
# A "no setups" run goes out silently; only an actual CE/PE idea makes a sound.
STOCK_SCAN_INTERVAL_MINUTES=30
# How many top ideas to include in the digest.
STOCK_SCAN_TOP_N=5
# Annualised IV (decimal) for the estimate fallback — stocks run hotter than the index.
STOCK_DEFAULT_IV=0.30

# ── Volatile-stock straddle scan (long-volatility plays) ──────────────────────
# A scheduled scan that ranks the NIFTY 50 by realised volatility (ATR % of spot)
# and, for the most volatile names, suggests buying the ATM straddle (CE + PE on
# one strike) — a direction-agnostic bet on a big move. Uses the same instrument
# master + live/estimated premiums as the stock scan above.
VOLATILITY_SCAN_ENABLED=true
# How often (minutes) to run the straddle scan during market hours (09:15–15:30).
# A "no straddles" run goes out silently; only an actual straddle makes a sound.
VOLATILITY_SCAN_INTERVAL_MINUTES=30
# How many top volatile-stock straddles to include in the digest.
VOLATILITY_SCAN_TOP_N=5

# Logging
LOG_LEVEL=INFO
LOG_FILE=nifty_ai_agent/logs/agent.log
